# Dune API key. Server-only. NEVER expose to the client (no NEXT_PUBLIC_ prefix).
DUNE_API_KEY=

# The saved Dune query id whose results power the dashboard.
DUNE_QUERY_ID=

# The default wallet the scheduled cron warms. Cached-results path.
# Any other ?wallet= triggers an on-demand Dune execute.
DUNE_DEFAULT_WALLET=
