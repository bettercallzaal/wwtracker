{
  "name": "soltracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/validate.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate.mjs",
    "test": "vitest run",
    "fetch:battles": "tsx scripts/ww-battles-fetch.ts",
    "recap": "tsx scripts/ww-recap.ts",
    "speaker-log": "tsx scripts/ww-speaker-log.ts",
    "decode:battle": "tsx scripts/ww-battle-decode.ts",
    "smoke:stats": "tsx scripts/smoke-stats-api.ts",
    "watch:live": "node scripts/live-watch.mjs --loop --every 60 --notify",
    "watch:live:once": "node scripts/live-watch.mjs",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.1",
    "typescript": "5.5.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22"
  }
}
